# Copy to .env and fill in. Never commit .env.
ENV=development
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=dermasense
# Leave empty to use an in-memory cache (single process only)
REDIS_URL=
# REQUIRED in production: a long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
OLLAMA_MODEL=llama3
# auto | sentence-transformers | hash (hash = offline, lower quality)
EMBEDDING_BACKEND=auto
WHISPER_MODEL=base
MAX_AUDIO_MB=15
